{
  "manifest_version": 3,
  "name": "SRPCOM Download Manager Integration",
  "version": "1.1.0",
  "description": "Integrasikan unduhan browser Chrome/Edge otomatis ke SRPCOM Download Manager.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:9876/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
